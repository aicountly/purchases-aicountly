# Build-time values (Metro inlines every EXPO_PUBLIC_* into the bundle: public, never secret).
# eas.json sets them per build profile; this file is for `npx expo start` on your machine.

# local | sandbox | production. A release build without it is production.
EXPO_PUBLIC_APP_ENV=sandbox
# Purchases API root (routes live under /v1). Empty = the environment's default.
EXPO_PUBLIC_API_BASE_URL=https://purchase.gh.aicountly.com/api
# Portal that serves the browser sign-in page (Google). Empty = the environment's default.
EXPO_PUBLIC_PORTAL_LOGIN_URL=https://sandbox.aicountly.com
