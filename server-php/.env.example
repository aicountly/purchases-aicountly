# ---------------------------------------------------------------------------
# Purchases API — server environment
#
# WHAT THIS IS. Read at RUNTIME on every request, unlike the React build, so it
# lives on the server and nowhere else.
#
# HOW TO USE IT. Copy this file to .env in the same folder, once per host, and
# fill in the blanks:
#
#     cd <document root>/api && cp .env.example .env
#
# The deploy ships THIS file on every run, and never ships or deletes your .env
# — it is excluded from the rsync in both directions. Neither is readable over
# HTTP: the .htaccess beside them answers 404 to every dotfile.
#
# Values here are examples, not defaults to keep. Anything marked REQUIRED has
# no working fallback; the API answers 503 without it.
# ---------------------------------------------------------------------------


# --- Identity --------------------------------------------------------------

# production | sandbox | local. REQUIRED on every deployed server (E8-ID A20).
# It decides which sibling products this API talks to (production Books,
# Manage, Pulse ... or their sandboxes) whenever no *_API_BASE is pinned below;
# the request's Host header is never consulted. AIC_ENVIRONMENT, when set,
# wins. An unrecognised value makes every derived call fail closed (503) and
# GET /api/health reports environment.problems; unset counts as production.
APP_ENV=production

# This product's name. It is sent to the other products as the caller identity
# and it prefixes every idempotency key this app mints, so changing it on a
# live host makes in-flight retries look like new requests. Leave it alone.
APP_PRODUCT_KEY=purchases


# --- Database (REQUIRED) ---------------------------------------------------
#
# The Purchases database and nothing else. This app never connects to another
# product's database — it asks that product over HTTP — so these credentials
# should grant access to this one schema and no more.

# The database NAME and USERNAME come from Console (Console > SaaS Database Details), which
# records them once per product and environment. In Console, generate Purchases's key on this
# deployment's row (Generate key; Console shows it ONCE, and it starts with sdb_) and set:
# CONSOLE_API_URL is the Console API base INCLUDING /api (https://console.aicountly.org/api).
CONSOLE_API_URL=
# The variable is called CONSOLE_DB_DETAILS_KEY. A key put under any other name leaves Console
# unused (nothing is asked, nothing fails loudly) and the local DB_NAME / DB_USER in charge.
CONSOLE_DB_DETAILS_KEY=
# The API asks GET $CONSOLE_API_URL/database-details/resolve with that key as a bearer token
# (src/ConsoleDatabaseDetails.php) for every request, bin/ worker and bin/migrate.php. Answers
# are cached (5 minutes); if Console is briefly unreachable the last good answer (up to 7 days
# old) is used and logged. A revoked key or inactive row is never covered by the cache.
# Only the name and username come from Console (the same split Connect uses): it never holds a
# password, and any other field in its answer is ignored. Host, port and password stay here and
# are still required (the password must belong to the user Console names for this row).

DB_HOST=127.0.0.1
DB_PORT=5432
DB_PASS=

# Optional: disable | allow | prefer | require | verify-ca | verify-full. Unset, libpq's default
# ("prefer") applies, which is what Connect uses.
# DB_SSLMODE=require

# Optional. Set only if the tables do not live in "public".
# DB_SCHEMA=public

# LOCAL FALLBACK ONLY - used when CONSOLE_API_URL / CONSOLE_DB_DETAILS_KEY are not both set
# (local development, the test suites). Do not set these on a deployed server: while the Console
# settings are present they are not read.
# DB_NAME=purchases_prod
# DB_USER=

# After setting these, apply the schema with `php <document root>/api/bin/migrate.php`.
# `php <document root>/api/bin/db-check.php` shows where each setting comes from and whether the
# database accepts it. Confirm with `curl https://<host>/api/health`
# (`database.source` is "console" when Console supplies the name and username).


# --- Talking to the other products -----------------------------------------
#
# The base URLs follow APP_ENV (or AIC_ENVIRONMENT) and normally need nothing
# here: APP_ENV=production calls the other products' production hosts and
# APP_ENV=sandbox their sandboxes. They are NEVER derived from the request's
# Host header (a client chooses that). With APP_ENV=production a base that
# points at a sandbox (*.gh.aicountly.com, gh-*) or loopback host is refused and
# reported by GET /api/health (environment.problems) -- check it after deploy.
#
# Set one only to point somewhere else — a local instance, or a cutover.
# BOOKS_API_BASE=https://books.aicountly.com
# INVENTORY_API_BASE=https://inventory.aicountly.com
# MANAGE_API_BASE=https://manage.aicountly.com

# Contacts: a supplier's people come from the company contacts Contacts links
# to the supplier's Books ledger (company routes only — /api/companies/{cmp}/
# contacts…, Contacts' company-contacts release). Derived from the host when
# unset. Until that release is deployed the supplier screen says company
# contacts are unavailable; suppliers are still chosen from their Books ledger.
# CONTACTS_API_BASE=https://contacts.aicountly.com


# --- Service keys ----------------------------------------------------------
#
# OUTBOUND: the key this app presents when it calls Inventory as itself rather
# than as the signed-in user (goods receipts, returns, serial/batch registration).
# Issued by Inventory. Without it those calls are rejected and documents sit in
# FAILED, visible on the screen they belong to. Books is always called as the
# signed-in person; there is no Books service key to set.

INVENTORY_SERVICE_KEY=

# INBOUND: keys this app ACCEPTS from its siblings, as app:key pairs. Only
# needed if another product calls this one — none does today (Email, Insights
# and Connect send the person's own session). Give each product its own key so
# a leak can be traced and rotated on its own.
# SERVICE_KEYS=insights:<key>
#
# A key acts for any company (cmp_id > 0): company scope is not configured per
# deployment (owner decision 2026-10-12). It is still limited by the routes
# that accept it and by the permissions below.
#
# What a product key may DO here, as Purchases permission codes. A product that
# is not listed is READ-ONLY: requisition.view, rfq.view, po.view, match.view,
# supplier.view. No key ever holds access.manage, settings.manage, an approval,
# match.resolve, bill.post or the return/claim settlement permissions,
# whatever is listed (src/ServiceKeys.php NEVER).
# SERVICE_KEY_PERMISSIONS=insights:po.view|reports.view


# --- AI, through AI Pulse --------------------------------------------------
#
# Purchases holds NO model key and calls no model provider. Its AI -- routing a
# question on the Ask panel and writing the summary sentence over figures this
# app already computed -- goes to AI Pulse, which picks the model Console binds
# to it, enforces the AI budgets and reports usage. Each call carries the
# signed-in user's own session and Purchases' own gateway key (below), so there
# is no model key to set here. The model never queries your data and never takes
# an action.
#
# With no model available through AI Pulse, the AI Insights screen still works:
# the rules engine answers, every panel says it is rules-based, and the screen
# reads "AI insights are currently unavailable".
#
# The origin follows APP_ENV (or AIC_ENVIRONMENT) like the other products':
# production uses https://pulse.aicountly.com, sandbox/local
# https://pulse.gh.aicountly.com. Never the request's Host header. Set it only
# to point somewhere else -- a local stub, or a cutover.
# PULSE_API_ORIGIN=https://pulse.aicountly.com
#
# PULSE_SERVICE_KEY is Purchases' OWN AI Pulse gateway key: what tells Pulse which
# product is calling, so the budgets, Console usage and audit are Purchases'. Mint
# it on the Pulse host, not here:
#     php spark pulse:gateway-key mint purchases
# (`purchases` is the name this API sends as X-Pulse-Product). Production and
# sandbox are separate Pulse deployments with separate keys: mint one on each and
# set each on its own host. It is printed once -- put it here straight from the
# terminal, never in a ticket, chat or commit. It is sent on EVERY call, beside
# the signed-in user's session; Purchases has no background AI job (no cron, no
# webhook, no public visitor), so a call without a signed-in user is never made.
# Until it is set only the session is sent, which AI Pulse accepts only until
# 2026-11-15 00:00 UTC: after that every AI call is refused (401
# product_key_required) and AI Insights is rules-only. After setting it, `php
# spark pulse:gateway-key list` on the Pulse host shows when it was first used.
# CONSOLE_SERVICE_KEY is not a stand-in, and a key with a line break in it is
# refused here rather than sent.
# PULSE_SERVICE_KEY=


# --- Portal and CORS -------------------------------------------------------

# The AICOUNTLY portal serves BOTH production and sandbox from my.aicountly.com
# (sandbox.aicountly.com is a login redirect only — it serves neither seskey nor
# validatesession). Set this only for a non-standard portal.
# PORTAL_AUTH_BASE=https://my.aicountly.com

# Both deployed environments are same-origin with their own app, so this stays
# empty in production. It exists so `npm run dev` can call a deployed API.
# CORS_ALLOWED_ORIGINS=http://localhost:5173


# --- Company lifecycle (Manage) ---------------------------------------------
# lib/company-lifecycle (the AICOUNTLY receiver kit), docs/COMPANY_LIFECYCLE.md. Manage signs its
# restricted / unrestricted / purge events with this secret (>= 32 chars, `openssl rand -hex 32`); the
# SAME value goes into Manage as LIFECYCLE_WEBHOOK_SECRET_PURCHASES. Unset: events answer 503 and nothing is
# restricted or purged.
LIFECYCLE_WEBHOOK_SECRET=
# Where purge acks go: https://manage.aicountly.com (sandbox https://manage.gh.aicountly.com). No default
# on purpose — a sandbox must never ack production.
MANAGE_API_URL=
# Optional: bearer for Manage internal/company-status, asked just before each company purge (a purge
# Manage has since reversed is refused).
# MANAGE_PRODUCT_SERVICE_KEY=
# Optional: another path for the reviewed purge manifest (default config/lifecycle-manifest.php).
# LIFECYCLE_MANIFEST=
