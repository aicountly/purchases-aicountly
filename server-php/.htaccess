# ---------------------------------------------------------------------------
# Purchases API — Apache config for <document root>/api on cPanel.
#
# This file is deployed with the API. The web build ships its own .htaccess for
# the document root, and those rules stop applying once these take over.
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On
  # No RewriteBase on purpose: Apache resolves the substitution against whatever
  # directory this file sits in, so the API works at <docroot>/api and at the
  # root of a dedicated vhost without editing this line. index.php strips its
  # own mount point to match.

  # Apache does not hand the Authorization header to PHP under CGI/FastCGI
  # unless it is copied explicitly. Without this the relay forwards no
  # credential, the portal answers 401, and sign-in fails for everyone with
  # nothing in the logs to explain it. (Hosts on Apache 2.4.13+ can use
  # `CGIPassAuth On` instead; this form works everywhere.)
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Only index.php may answer. Every other real file or folder shipped here
  # (src/, bin/, tests/, database/, a PHP error_log) would otherwise be served
  # as text or run as PHP against the live .env — the test suite alone TRUNCATEs
  # every table on load. .well-known is kept reachable for SSL validation. The
  # pattern is relative to this directory, like the rule above.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule !^(index\.php|\.well-known/.*)?$ - [R=404,L]

  # Everything that is not a real file goes to the front controller.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L]
</IfModule>

# --- Hardening -------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header always set Cache-Control "no-store"
</IfModule>

# The API's .env sits inside the document root, so without this it would be
# fetchable over HTTP at https://purchases.aicountly.com/api/.env. RedirectMatch
# is mod_alias, so unlike the rewrite rules above it still applies inside a
# subdirectory that ships its own .htaccess — the dotfile ban holds at any depth.
RedirectMatch 404 /\.(?!well-known)

# PHP writes an "error_log" in whatever directory a script errors in; one left
# under the API would leak file paths, SQL and secrets. Refuse it at any depth,
# including a rotated error_log.1, and again via mod_alias so a nested
# public/.htaccess cannot re-expose it.
RedirectMatch 404 (?i)/error_log(\.[^/]*)?$
